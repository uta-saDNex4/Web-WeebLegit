# PostgreSQL runs on the host machine in Docker, published on 5432.
DATABASE_URL=postgresql://admin:matkhau_xinfu@host.docker.internal:5432/contract_verifier_db

# Origins allowed to call the backend from the browser.
# Use "*" for LAN-wide access.
CORS_ORIGINS=*

# Internal backend URL used by the frontend container.
BACKEND_INTERNAL_URL=http://backend:8000

# DeepSeek API Key (OpenAI-compatible) for real-time AI contract analysis & chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://vibi.top/v1
DEEPSEEK_MODEL=deepseek-v4.1-flash
